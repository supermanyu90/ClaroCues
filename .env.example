# Gemini API key for server-side generation, grounding, transcription and the live concierge.
# Without it the app still runs: planning endpoints return clearly labelled reference content,
# and transcription / ASL gloss / sign recognition / live voice are disabled rather than faked.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL of the deployment (used by AI Studio).
APP_URL="MY_APP_URL"

# Server port (default 3000).
# PORT=3000

# Optional model overrides.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Requests per minute per IP across /api/* (default 30).
# RATE_LIMIT_PER_MINUTE=30

# Set to true behind a reverse proxy / Cloud Run so rate limiting sees the real client IP.
# TRUST_PROXY=true

# Comma-separated extra origins allowed to open the /live WebSocket (same origin is always allowed).
# ALLOWED_ORIGINS=https://clarocues.example.com
